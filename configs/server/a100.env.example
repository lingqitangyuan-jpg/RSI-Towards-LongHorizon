# Copy to a local file (for example configs/server/a100.env) and source it on
# the Linux server. This template intentionally contains no credentials.

# Repository and reference checkout locations.
export RSI_PROJECT_ROOT="/srv/$USER/RSI-Towards-LongHorizon"
export RSI_HZ_ROOT="$RSI_PROJECT_ROOT/sources/repo/Harness_zero/harness-zero-main"
export RSI_APPWORLD_DATA_ROOT="/srv/$USER/datasets/appworld"
export RSI_RUN_ROOT="/srv/$USER/rsi-runs"
export RSI_CACHE_ROOT="/srv/$USER/.cache/rsi-long-horizon"

# Scheduler values are site-specific. Keep TODO until the lab confirms them.
export RSI_SCHEDULER="TODO"          # slurm, pbs, or another local scheduler
export RSI_PARTITION="TODO"
export RSI_ACCOUNT="TODO"
export RSI_GPU_TYPE="A100"
export RSI_GPUS_PER_JOB="1"

# Runtime pins required by the AppWorld/Harness-Zero integration.
export RSI_PYTHON_MIN="3.12"
export RSI_PYTHON_MAX_EXCLUSIVE="3.14"
export RSI_HARBOR_VERSION="0.21.0"
export RSI_APPWORLD_VERSION="0.1.3.post1"

# Model/provider identifiers are placeholders until access and licensing are
# confirmed. Secrets must be injected by the scheduler or shell environment.
export RSI_STUDENT_MODEL_ID="TODO"
export RSI_STUDENT_MODEL_REVISION="TODO"
export RSI_TEACHER_PROVIDER="TODO"
export RSI_TEACHER_MODEL_ID="TODO"
export RSI_TEACHER_MODEL_REVISION="TODO"
# export OPENAI_API_KEY="..."  # never commit a populated value

# Optional execution controls for the pilot.
export RSI_SEED="17"
export RSI_MAX_CONCURRENT_JOBS="1"
export RSI_MAX_TOTAL_GPU_HOURS="12"
